# python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# test, lint, type-check, and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/

# virtual environments and local environment variables
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# jupyter
.ipynb_checkpoints/

# editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# operating-system files
.DS_Store
Thumbs.db

# user-provided data and generated outputs
/data/*
!/data/.gitkeep
/runs/
*.nii
*.nii.gz
*.h5
*.hdf5
*.pt
*.pth

# local configuration is private; portable examples may be committed
/configs/*.yaml
!/configs/*.example.yaml
!/configs/.gitkeep
